<%- include('../partials/header') %>
<h1 class="text-3xl font-bold mb-6">Modifier Mon Profil</h1>
<div class="max-w-2xl space-y-6">
  <div class="bg-white p-8 rounded-2xl border shadow-sm">
    <form action="/member/profile" method="POST" enctype="multipart/form-data" class="space-y-4">
      <div><label class="text-sm font-bold">Photo</label><input type="file" name="photo" accept="image/*" class="w-full px-4 py-2 border rounded-lg mt-1"></div>
      <div class="grid grid-cols-2 gap-4">
        <div><label class="text-sm font-bold">Nom</label><input name="name" value="<%= member.name %>" required class="w-full px-4 py-2 border rounded-lg mt-1"></div>
        <div><label class="text-sm font-bold">Spécialisation</label><input name="spec" value="<%= member.spec || '' %>" class="w-full px-4 py-2 border rounded-lg mt-1"></div>
      </div>
      <div><label class="text-sm font-bold">Compétences</label><input name="skills" value="<%= member.skills || '' %>" class="w-full px-4 py-2 border rounded-lg mt-1"></div>
      <div><label class="text-sm font-bold">URL Site</label><input name="url" type="url" value="<%= member.url || '' %>" class="w-full px-4 py-2 border rounded-lg mt-1"></div>
      <div><label class="text-sm font-bold">Bio</label><textarea name="bio" rows="4" class="w-full px-4 py-2 border rounded-lg mt-1"><%= member.bio || '' %></textarea></div>
      <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg font-bold hover:bg-red-700">Sauvegarder</button>
    </form>
  </div>
  <div class="bg-white p-8 rounded-2xl border shadow-sm">
    <h3 class="text-lg font-bold mb-4">🔐 Changer le mot de passe</h3>
    <form action="/member/password" method="POST" class="space-y-4">
      <div><label class="text-sm font-bold">Actuel</label><input type="password" name="current" required class="w-full px-4 py-2 border rounded-lg mt-1"></div>
      <div class="grid grid-cols-2 gap-4">
        <div><label class="text-sm font-bold">Nouveau</label><input type="password" name="newPwd" minlength="6" required class="w-full px-4 py-2 border rounded-lg mt-1"></div>
        <div><label class="text-sm font-bold">Confirmer</label><input type="password" name="confirm" minlength="6" required class="w-full px-4 py-2 border rounded-lg mt-1"></div>
      </div>
      <button type="submit" class="bg-dark text-white px-6 py-2 rounded-lg font-bold">Changer</button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>