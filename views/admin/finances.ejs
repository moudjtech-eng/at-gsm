<%- include('../partials/header') %>

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
  <h1 class="text-2xl md:text-3xl font-bold">Tableau de Bord Financier</h1>
  
  <!-- LE NOUVEAU BOUTON EST ICI -->
  <a href="/admin/finances/statement" class="bg-slate-800 text-white px-6 py-2.5 rounded-xl font-bold hover:bg-slate-900 transition-colors flex items-center gap-2 shadow-md w-full md:w-auto justify-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
    Générer le Relevé
  </a>
</div>



<!-- CARTES DE STATISTIQUES (NOUVEAU) -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
  <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
    <p class="text-slate-500 text-xs uppercase font-bold mb-1">Solde Actuel de la Caisse</p>
    <p class="text-3xl md:text-4xl font-black text-green-600"><%= currentBalance ? currentBalance.toLocaleString('fr-FR') : 0 %> FCFA</p>
  </div>
  
  <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
    <p class="text-slate-500 text-xs uppercase font-bold mb-1">Total des Revenus (Cotisations + Adhésions)</p>
    <p class="text-2xl font-extrabold text-blue-600"><%= totalRevenue ? totalRevenue.toLocaleString('fr-FR') : 0 %> FCFA</p>
  </div>
  
  <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
    <p class="text-slate-500 text-xs uppercase font-bold mb-1">Total des Dépenses / Retraits</p>
    <p class="text-2xl font-extrabold text-red-600"><%= totalExpenses ? totalExpenses.toLocaleString('fr-FR') : 0 %> FCFA</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
  <!-- CONFIGURATION DU SOLDE INITIAL -->
  <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm h-fit">
    <h2 class="text-xl font-bold mb-4">⚙️ Configuration de la Caisse</h2>
    <p class="text-sm text-slate-600 mb-4">Entrez la somme que l'association possédait en caisse <strong>avant</strong> la création du site.</p>
    <form action="/admin/finances/initial-balance" method="POST" class="flex gap-2">
      <input name="amount" type="number" required value="<%= initialBalance || 0 %>" class="flex-1 px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary outline-none">
      <button class="bg-dark text-white px-6 py-2 rounded-lg font-bold">Enregistrer</button>
    </form>
  </div>

  <!-- FORMULAIRE DE RETRAIT (TG UNIQUEMENT) -->
  <div class="bg-white p-6 rounded-2xl border-2 border-red-100 shadow-sm">
    <h2 class="text-xl font-bold text-red-600 mb-2">🚨 Effectuer un Retrait</h2>
    <p class="text-xs text-slate-500 mb-4">Réservé au Trésorier Général (TG). Toute opération est tracée.</p>
    
    <form action="/admin/finances/withdraw" method="POST" class="space-y-3">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <label class="text-xs font-bold text-slate-700">Montant (FCFA)</label>
          <input name="amount" type="number" required placeholder="Ex: 5000" class="w-full px-4 py-2 border rounded-lg mt-1">
        </div>
        <div>
          <label class="text-xs font-bold text-slate-700">Motif du retrait</label>
          <input name="reason" type="text" required placeholder="Ex: Achat matériel" class="w-full px-4 py-2 border rounded-lg mt-1">
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <label class="text-xs font-bold text-slate-700">Numéro NPI</label>
          <input name="npi" type="text" required placeholder="Votre NPI" class="w-full px-4 py-2 border rounded-lg mt-1">
        </div>
        <div>
          <label class="text-xs font-bold text-slate-700">Date d'expiration CIP</label>
          <input name="cip_expiry" type="date" required class="w-full px-4 py-2 border rounded-lg mt-1">
        </div>
      </div>
      <div>
        <label class="text-xs font-bold text-slate-700">Clé Privée (Code Secret TG)</label>
        <input name="secret_key" type="password" required placeholder="Entrez votre clé privée" class="w-full px-4 py-2 border rounded-lg mt-1 bg-red-50 font-mono text-red-700">
      </div>
      <button type="submit" class="w-full bg-red-600 text-white py-2 rounded-lg font-bold hover:bg-red-700 transition-colors">Valider le Retrait</button>
    </form>
  </div>
</div>

<!-- RELEVÉ DES MOUVEMENTS (HISTORIQUE DES DÉPENSES) -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-8">
  <div class="p-4 md:p-6 border-b flex justify-between items-center bg-slate-50">
    <h2 class="text-lg font-bold text-slate-800">Relevé des Mouvements (Dépenses)</h2>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm min-w-[600px]">
      <thead class="bg-white"><tr>
        <th class="px-4 py-3 text-left font-semibold text-slate-600">Date</th>
        <th class="px-4 py-3 text-left font-semibold text-slate-600">Motif</th>
        <th class="px-4 py-3 text-left font-semibold text-slate-600">NPI</th>
        <th class="px-4 py-3 text-right font-semibold text-slate-600">Montant</th>
      </tr></thead>
      <tbody class="divide-y divide-slate-100">
        <% if (!expenses || !expenses.length) { %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-slate-400 italic">Aucun retrait effectué pour le moment.</td></tr>
        <% } %>
        <% if (expenses) { expenses.forEach(e => { %>
          <tr>
            <td class="px-4 py-3"><%= new Date(e.created_at).toLocaleDateString('fr-FR') %></td>
            <td class="px-4 py-3 font-medium"><%= e.reason %></td>
            <td class="px-4 py-3 text-slate-500 font-mono text-xs"><%= e.npi %></td>
            <td class="px-4 py-3 text-right font-bold text-red-600">-<%= Number(e.amount).toLocaleString('fr-FR') %> FCFA</td>
          </tr>
        <% }) } %>
      </tbody>
    </table>
  </div>
</div>

<!-- LISTE DES MAUVAIS PAYEURS -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="p-4 md:p-6 border-b flex justify-between items-center">
    <h2 class="text-lg md:text-xl font-bold text-slate-800">Membres en retard</h2>
    <span class="px-2 py-1 bg-red-100 text-red-700 text-[10px] md:text-xs font-bold rounded-full"><%= debtors ? debtors.length : 0 %> concerné(s)</span>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm min-w-[500px]">
      <thead class="bg-slate-50"><tr>
        <th class="px-4 py-3 text-left font-semibold text-slate-600">Membre</th>
        <th class="px-4 py-3 text-left font-semibold text-slate-600">Contact</th>
        <th class="px-4 py-3 text-left font-semibold text-slate-600">Retard</th>
        <th class="px-4 py-3 text-right font-semibold text-slate-600">Action</th>
      </tr></thead>
      <tbody class="divide-y divide-slate-100">
        <% if (!debtors || !debtors.length) { %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-green-600 font-bold">Tous les membres sont à jour ! 🎉</td></tr>
        <% } %>
        <% if (debtors) { debtors.forEach(d => { %>
          <tr>
            <td class="px-4 py-3 font-medium"><%= d.name %></td>
            <td class="px-4 py-3">
              <p class="text-slate-700"><%= d.phone %></p>
              <p class="text-xs text-slate-500"><%= d.email %></p>
            </td>
            <td class="px-4 py-3">
              <span class="px-2 py-1 bg-red-100 text-red-700 text-[10px] font-bold rounded-full uppercase">
                <%= d.debt_months %> mois (<%= (d.debt_months * 500).toLocaleString('fr-FR') %> FCFA)
              </span>
            </td>
            <td class="px-4 py-3 text-right">
              <form action="/admin/finances/remind/<%= d.id %>" method="POST" onsubmit="return confirm('Envoyer un email de relance à <%= d.name %> ?')" class="inline">
                <button type="submit" class="bg-red-50 text-red-700 px-2 md:px-3 py-1 md:py-2 rounded-lg font-bold text-[10px] md:text-xs hover:bg-red-100 transition-colors flex items-center gap-1 md:gap-2 ml-auto">
                  Relancer
                </button>
              </form>
            </td>
          </tr>
        <% }) } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>