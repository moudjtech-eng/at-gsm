<%- include('partials/header') %>

<div class="max-w-4xl mx-auto">
  <!-- En-tête du profil avec bannière -->
  <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-200">
    <div class="h-40 bg-gradient-to-r from-slate-900 to-slate-700 relative">
      <a href="/directory" class="absolute top-4 left-4 bg-white/20 hover:bg-white/30 backdrop-blur text-white px-4 py-2 rounded-lg text-sm font-bold transition-all flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Retour à l'annuaire
      </a>
    </div>
    
    <div class="px-8 pb-8 relative">
      <!-- Avatar -->
      <div class="relative -mt-16 mb-4 flex justify-between items-end">
        <div class="h-32 w-32 rounded-2xl bg-white p-1 shadow-lg">
          <% if (member.photo_path) { %>
            <img src="/uploads/<%= member.photo_path %>" class="h-full w-full rounded-xl object-cover">
          <% } else { %>
            <div class="w-full h-full rounded-xl bg-slate-200 flex items-center justify-center text-slate-500 font-bold text-5xl"><%= member.name.charAt(0) %></div>
          <% } %>
        </div>
        <% if (member.url) { %>
          <a href="<%= member.url %>" target="_blank" class="bg-primary hover:bg-red-700 text-white px-6 py-2 rounded-xl font-bold transition-colors flex items-center gap-2 shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            Visiter le Site
          </a>
        <% } %>
      </div>

      <!-- Infos principales -->
      <div class="mb-6">
        <h1 class="text-3xl font-extrabold text-dark"><%= member.name %></h1>
        <p class="text-primary font-bold text-lg mt-1"><%= member.spec %></p>
      </div>

      <!-- Compétences -->
      <% if (member.skills) { %>
        <div class="mb-8">
          <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wide mb-3">Compétences Clés</h3>
          <div class="flex flex-wrap gap-2">
            <% member.skills.split(',').forEach(skill => { %>
              <span class="px-3 py-1 bg-slate-100 border border-slate-200 text-slate-700 rounded-lg text-sm font-medium">
                <%= skill.trim() %>
              </span>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Bio -->
      <div class="mb-8">
        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wide mb-3">À propos</h3>
        <p class="text-slate-600 leading-relaxed">
          <%= member.bio || "Ce technicien n'a pas encore renseigné sa biographie." %>
        </p>
      </div>

      <!-- Contact -->
      <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wide mb-4">Contact</h3>
        <div class="flex items-center gap-3 text-slate-700 font-medium">
          <div class="w-10 h-10 bg-green-100 text-green-600 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          </div>
          <span><%= member.phone || "Non renseigné" %></span>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>