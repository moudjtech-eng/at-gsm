<%- include('../partials/header') %>
<h1 class="text-3xl font-bold mb-8">Panel Admin</h1>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white p-6 rounded-2xl border shadow-sm">
    <p class="text-slate-500 text-xs uppercase font-bold">Membres</p>
    <p class="text-3xl font-extrabold"><%= stats.totalMembers %></p>
  </div>
  <div class="bg-white p-6 rounded-2xl border shadow-sm">
    <p class="text-slate-500 text-xs uppercase font-bold text-green-600">Paiements Validés</p>
    <p class="text-3xl font-extrabold text-green-600"><%= stats.totalValidated %></p>
  </div>
  <div class="bg-white p-6 rounded-2xl border shadow-sm">
    <p class="text-slate-500 text-xs uppercase font-bold text-primary">Candidatures</p>
    <p class="text-3xl font-extrabold text-primary"><%= stats.totalApplications %></p>
  </div>
  <div class="bg-white p-6 rounded-2xl border shadow-sm">
    <p class="text-slate-500 text-xs uppercase font-bold">News</p>
    <p class="text-3xl font-extrabold"><%= stats.totalNews %></p>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <a href="/admin/members" class="bg-dark text-white p-6 rounded-2xl font-bold flex justify-between items-center hover:bg-slate-800 transition-colors">👥 Membres <span>→</span></a>
  <a href="/admin/payments" class="bg-primary text-white p-6 rounded-2xl font-bold flex justify-between items-center hover:bg-red-700 transition-colors">💳 Paiements <span>→</span></a>
  <a href="/admin/applications" class="bg-yellow-600 text-white p-6 rounded-2xl font-bold flex justify-between items-center hover:bg-yellow-700 transition-colors">📝 Candidatures <span>→</span></a>
  <a href="/admin/news" class="bg-green-700 text-white p-6 rounded-2xl font-bold flex justify-between items-center hover:bg-green-800 transition-colors">📰 News <span>→</span></a>
  <a href="/admin/finances" class="bg-green-600 text-white p-6 rounded-2xl font-bold flex justify-between items-center shadow-sm hover:bg-green-700 transition-colors md:col-span-2">💰 Voir les Finances & Dettes <span>→</span></a>
</div>
<%- include('../partials/footer') %>