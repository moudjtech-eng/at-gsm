<%- include('../partials/header') %>
<h1 class="text-2xl md:text-3xl font-bold mb-6">Tableau de Bord Financier</h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mb-8">
  <div class="bg-white p-4 md:p-6 rounded-2xl border shadow-sm">
    <p class="text-slate-500 text-xs uppercase font-bold mb-1">Revenus du Mois</p>
    <p class="text-2xl md:text-3xl font-extrabold text-green-600"><%= revenueThisMonth.toLocaleString('fr-FR') %> FCFA</p>
  </div>
  <div class="bg-white p-4 md:p-6 rounded-2xl border shadow-sm">
    <p class="text-slate-500 text-xs uppercase font-bold mb-1">Total Encaissé</p>
    <p class="text-2xl md:text-3xl font-extrabold text-blue-600"><%= totalRevenue.toLocaleString('fr-FR') %> FCFA</p>
  </div>
  <div class="bg-white p-4 md:p-6 rounded-2xl border shadow-sm">
    <p class="text-slate-500 text-xs uppercase font-bold mb-1">Dettes (À recouvrer)</p>
    <p class="text-2xl md:text-3xl font-extrabold text-red-600"><%= totalDebt.toLocaleString('fr-FR') %> FCFA</p>
  </div>
</div>

<div class="bg-white rounded-2xl border shadow-sm overflow-hidden">
  <div class="p-4 md:p-6 border-b flex justify-between items-center">
    <h2 class="text-lg md:text-xl font-bold text-slate-800">Membres en retard</h2>
    <span class="px-2 py-1 bg-red-100 text-red-700 text-[10px] md:text-xs font-bold rounded-full"><%= debtors.length %> concerné(s)</span>
  </div>
  
  <div class="overflow-x-auto">
    <table class="w-full text-sm min-w-[500px]">
      <thead class="bg-slate-50"><tr>
        <th class="px-4 py-3 text-left font-semibold text-slate-600">Membre</th>
        <th class="px-4 py-3 text-left font-semibold text-slate-600 hidden md:table-cell">Contact</th>
        <th class="px-4 py-3 text-left font-semibold text-slate-600">Retard</th>
        <th class="px-4 py-3 text-right font-semibold text-slate-600">Action</th>
      </tr></thead>
      <tbody class="divide-y divide-slate-100">
        <% if (!debtors.length) { %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-green-600 font-bold">Tous les membres sont à jour ! 🎉</td></tr>
        <% } %>
        <% debtors.forEach(d => { %>
          <tr>
            <td class="px-4 py-3 font-medium"><%= d.name %></td>
            <td class="px-4 py-3 hidden md:table-cell">
              <p class="text-slate-700"><%= d.phone %></p>
              <p class="text-xs text-slate-500"><%= d.email %></p>
            </td>
            <td class="px-4 py-3">
              <span class="px-2 py-1 bg-red-100 text-red-700 text-[10px] font-bold rounded-full uppercase">
                <%= d.debt_months %> mois
              </span>
            </td>
            <td class="px-4 py-3 text-right">
              <form action="/admin/finances/remind/<%= d.id %>" method="POST" onsubmit="return confirm('Envoyer un email de relance à <%= d.name %> ?')" class="inline">
                <button type="submit" class="bg-red-50 text-red-700 px-2 md:px-3 py-1 md:py-2 rounded-lg font-bold text-[10px] md:text-xs hover:bg-red-100 transition-colors flex items-center gap-1 md:gap-2 ml-auto">
                  Relancer
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>