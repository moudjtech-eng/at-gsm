<%- include('partials/header') %>
<div class="max-w-3xl mx-auto">
  <h1 class="text-3xl font-bold mb-2">Formulaire de Candidature</h1>
  <p class="text-slate-600 mb-8">Rejoignez le réseau d'élite.</p>
  <form action="/apply" method="POST" enctype="multipart/form-data" class="bg-white p-8 rounded-3xl border shadow-xl space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div><label class="text-sm font-bold">Nom Complet</label><input name="name" required class="w-full px-4 py-3 border rounded-xl mt-1"></div>
      <div><label class="text-sm font-bold">Email</label><input name="email" type="email" required class="w-full px-4 py-3 border rounded-xl mt-1"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div><label class="text-sm font-bold">Téléphone</label><input name="phone" type="tel" required class="w-full px-4 py-3 border rounded-xl mt-1"></div>
      <div><label class="text-sm font-bold">Spécialité</label><input name="spec" required class="w-full px-4 py-3 border rounded-xl mt-1"></div>
    </div>
    <div>
      <label class="text-sm font-bold">Diplômes & Certificats (PDF UNIQUEMENT)</label>
      <input type="file" name="docs" accept="application/pdf" required class="w-full px-4 py-3 border rounded-xl mt-1 bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-red-50 file:text-red-700 hover:file:bg-red-100">
    </div>
    <button type="submit" class="w-full py-4 bg-primary text-white rounded-xl font-bold hover:bg-red-700">Envoyer ma Candidature</button>
  </form>
</div>
<%- include('partials/footer') %>