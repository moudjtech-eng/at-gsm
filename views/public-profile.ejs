<%- include('partials/header') %>

<!-- On charge la librairie Leaflet pour la carte -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="max-w-4xl mx-auto pb-10">
  <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-200">
    
    <!-- BANNIÈRE -->
    <div class="h-32 md:h-48 bg-gradient-to-r from-slate-900 to-slate-700 relative">
      <a href="/directory" class="absolute top-4 left-4 bg-white/20 hover:bg-white/30 backdrop-blur text-white px-3 md:px-4 py-2 rounded-lg text-xs md:text-sm font-bold transition-all flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Retour
      </a>
    </div>
    
    <div class="px-4 md:px-8 pb-8 relative">
      
      <!-- PHOTO ET BOUTON SITE -->
      <div class="relative -mt-12 md:-mt-16 mb-4 flex flex-col md:flex-row md:justify-between md:items-end gap-4">
        <div class="h-24 w-24 md:h-32 md:w-32 rounded-2xl bg-white p-1 shadow-lg shrink-0">
          <% if (member.photo_path) { %>
            <img src="/uploads/<%= member.photo_path %>" onerror="this.src='https://ui-avatars.com/api/?name=<%= member.name %>&background=dc2626&color=fff&size=200'" class="h-full w-full rounded-xl object-cover">
          <% } else { %>
            <img src="https://ui-avatars.com/api/?name=<%= member.name %>&background=dc2626&color=fff&size=200" class="h-full w-full rounded-xl object-cover">
          <% } %>
        </div>
        
        <% if (member.url) { %>
          <a href="<%= member.url %>" target="_blank" class="bg-primary hover:bg-red-700 text-white px-4 py-2 md:px-6 md:py-3 rounded-xl font-bold transition-colors flex items-center justify-center gap-2 shadow-md w-full md:w-auto text-sm md:text-base">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            Visiter le Site
          </a>
        <% } %>
      </div>

      <!-- INFOS PRINCIPALES -->
      <div class="mb-6">
        <h1 class="text-2xl md:text-3xl font-extrabold text-dark"><%= member.name %></h1>
        <p class="text-primary font-bold text-sm md:text-lg mt-1"><%= member.spec %></p>
        <% if (member.location) { %>
          <p class="text-slate-500 text-sm flex items-center gap-1 mt-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <%= member.location %>
          </p>
        <% } %>
      </div>

      <!-- COMPÉTENCES -->
      <% if (member.skills) { %>
        <div class="mb-8">
          <h3 class="text-xs md:text-sm font-bold text-slate-400 uppercase tracking-wide mb-3">Compétences Clés</h3>
          <div class="flex flex-wrap gap-2">
            <% member.skills.split(',').forEach(skill => { %>
              <span class="px-2 md:px-3 py-1 bg-slate-100 border border-slate-200 text-slate-700 rounded-lg text-xs md:text-sm font-medium">
                <%= skill.trim() %>
              </span>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- BIO -->
      <div class="mb-8">
        <h3 class="text-xs md:text-sm font-bold text-slate-400 uppercase tracking-wide mb-3">À propos</h3>
        <p class="text-slate-600 text-sm md:text-base leading-relaxed">
          <%= member.bio || "Ce technicien n'a pas encore renseigné sa biographie." %>
        </p>
      </div>

      <!-- SECTION CARTE (MÉTHODE DATA-* POUR ÉVITER LES ERREURS VS CODE) -->
      <% if (member.latitude && member.longitude) { %>
        
        <!-- On cache les coordonnées ici pour que VS Code ne panique pas -->
        <div id="map-data" 
             data-lat="<%= member.latitude %>" 
             data-lng="<%= member.longitude %>" 
             data-name="<%= member.name %>" 
             data-location="<%= member.location || '' %>" 
             class="hidden">
        </div>

        <div class="mb-8 rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-white">
          <div class="bg-gradient-to-r from-blue-700 to-green-500 p-4 text-white">
            <h3 class="font-bold flex items-center gap-2 text-sm md:text-base">
              <span class="text-red-400 text-lg">📍</span> LOCALISATION DE L'ÉTABLISSEMENT
            </h3>
          </div>
          
          <div id="map" class="w-full h-64 md:h-80 z-0"></div>
          
          <div class="p-4 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2">
              <div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <div>
                <p class="font-bold text-slate-800 uppercase text-sm"><%= member.name %></p>
                <p class="text-xs text-slate-500 font-mono"><%= member.latitude %>° N, <%= member.longitude %>° E</p>
              </div>
            </div>
            
            <a href="https://www.google.com/maps/search/?api=1&query=<%= member.latitude %>,<%= member.longitude %>" target="_blank" class="w-full md:w-auto bg-white border-2 border-slate-200 text-blue-600 px-6 py-2 rounded-xl font-bold hover:bg-slate-50 transition-colors flex items-center justify-center gap-2 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
              Ouvrir dans Google Maps
            </a>
          </div>
        </div>

        <!-- Script pour dessiner la carte (Zéro erreur rouge) -->
        <script>
          document.addEventListener("DOMContentLoaded", function() {
            const mapData = document.getElementById("map-data");
            const lat = parseFloat(mapData.dataset.lat);
            const lng = parseFloat(mapData.dataset.lng);
            const name = mapData.dataset.name;
            const location = mapData.dataset.location;

            // Initialiser la carte
            var map = L.map('map').setView([lat, lng], 16);
            
            // Ajouter les tuiles OpenStreetMap
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              attribution: '&copy; OpenStreetMap'
            }).addTo(map);
            
            // Ajouter un marqueur
            L.marker([lat, lng]).addTo(map)
              .bindPopup("<b>" + name + "</b><br>" + location)
              .openPopup();
          });
        </script>
      <% } else { %>
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 text-center mb-8">
          <p class="text-slate-500 text-sm italic">La localisation sur la carte n'est pas encore configurée par ce technicien.</p>
        </div>
      <% } %>

      <!-- CONTACT -->
      <div class="bg-slate-50 p-4 md:p-6 rounded-2xl border border-slate-200">
        <h3 class="text-xs md:text-sm font-bold text-slate-400 uppercase tracking-wide mb-4">Contact</h3>
        <div class="flex items-center gap-3 text-slate-700 font-medium text-sm md:text-base">
          <div class="w-8 h-8 md:w-10 md:h-10 bg-green-100 text-green-600 rounded-full flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          </div>
          <span><%= member.phone || "Non renseigné" %></span>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>