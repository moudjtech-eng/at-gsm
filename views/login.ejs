<%- include('partials/header') %>
<div class="max-w-md mx-auto mt-8">
  <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-xl">
    <h2 class="text-2xl font-bold mb-6 text-center">Connexion</h2>
    <form action="/auth/login" method="POST" class="space-y-4">
      <div>
        <label class="text-sm font-bold text-slate-700">Email</label>
        <input name="email" type="email" required class="w-full px-4 py-3 border border-slate-300 rounded-xl mt-1">
      </div>
      <div>
        <label class="text-sm font-bold text-slate-700">Mot de passe</label>
        <input name="password" type="password" required class="w-full px-4 py-3 border border-slate-300 rounded-xl mt-1">
      </div>
      <button type="submit" class="w-full py-3 bg-primary text-white rounded-xl font-bold hover:bg-red-700">Se connecter</button>
      <div class="mt-4 text-center">
  <a href="/auth/forgot-password" class="text-sm text-slate-500 hover:text-primary font-medium">Mot de passe oublié ?</a>
</div>
    </form>
  </div>
  
</div>
<%- include('partials/footer') %>