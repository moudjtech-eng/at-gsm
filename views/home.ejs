<%- include('partials/header') %>

<div class="relative overflow-hidden rounded-3xl bg-dark text-white shadow-2xl min-h-[400px] md:min-h-[500px] flex items-center mb-12">
  <div id="hero-carousel" class="absolute inset-0 w-full h-full">
    <div class="carousel-item active relative w-full h-full">
      <img src="/images/slide1.jpg" onerror="this.src='https://images.unsplash.com/photo-1512428559087-565658d65721?auto=format&fit=crop&q=80&w=1200'" class="w-full h-full object-cover opacity-40" alt="Slide 1">
      <div class="absolute inset-0 bg-gradient-to-t from-dark via-transparent to-transparent"></div>
    </div>
    <div class="carousel-item relative w-full h-full">
      <img src="/images/slide2.jpg" onerror="this.src='https://images.unsplash.com/photo-1581092921461-e777640d82fc?auto=format&fit=crop&q=80&w=1200'" class="w-full h-full object-cover opacity-40" alt="Slide 2">
      <div class="absolute inset-0 bg-gradient-to-t from-dark via-transparent to-transparent"></div>
    </div>
  </div>
  
  <div class="relative z-10 max-w-3xl mx-auto px-8 py-20 text-center">
    <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">Élever l'Excellence GSM à <span class="text-primary">Bohicon</span></h1>
    <p class="text-lg md:text-xl text-slate-300 mb-10">L'association officielle des techniciens GSM professionnels.</p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a href="/directory" class="bg-primary hover:bg-red-700 px-8 py-3 rounded-full font-bold">Trouver un Technicien</a>
      <a href="/apply" class="bg-white/10 hover:bg-white/20 border border-white/20 px-8 py-3 rounded-full font-bold">Rejoindre</a>
    </div>
  </div>
</div>

<div class="bg-slate-900 rounded-3xl p-8 md:p-12 mb-12 text-center shadow-xl relative overflow-hidden">
  <div class="absolute inset-0 opacity-5 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-white via-slate-400 to-transparent"></div>
  <div class="relative z-10 max-w-2xl mx-auto">
    <div class="mx-auto w-12 h-12 bg-slate-800 rounded-full flex items-center justify-center mb-6 text-slate-300">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
    </div>
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-4 tracking-wide">En mémoire de notre frère</h2>
    <p class="text-slate-300 text-lg mb-2 italic">"Ceux qu'on aime ne meurent jamais, ils vivent dans nos cœurs."</p>
    <p class="text-slate-400 text-sm mt-4">L'Association AT-GSM Bohicon rend un vibrant hommage à <strong class="text-white">Edjo</strong>, un membre regretté qui a marqué notre communauté. Son héritage et sa passion pour le métier resteront à jamais gravés dans nos mémoires.</p>
    <div class="mt-6 flex justify-center">
      <span class="px-4 py-1 border border-slate-700 text-slate-400 rounded-full text-xs uppercase tracking-widest font-bold">Repose en paix</span>
    </div>
  </div>
</div>

<style>
  .carousel-item { display: none; }
  .carousel-item.active { display: block; animation: fadeIn 1s; }
  @keyframes fadeIn { from { opacity: 0.5; } to { opacity: 1; } }
</style>
<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.carousel-item');
  setInterval(() => {
    slides[currentSlide].classList.remove('active');
    currentSlide = (currentSlide + 1) % slides.length;
    slides[currentSlide].classList.add('active');
  }, 5000);
</script>

<h2 class="text-3xl font-bold mb-6">Nos Projets & Actualités</h2>
<% if (!news.length) { %>
  <p class="text-slate-500 italic">Aucune actualité pour le moment.</p>
<% } else { %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <% news.forEach(n => { %>
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-lg transition-shadow flex flex-col">
        
        <!-- IMAGE DE COUVERTURE -->
        <div class="h-48 bg-slate-100 relative overflow-hidden shrink-0">
          <% if (n.image_path) { %>
            <img src="/uploads/<%= n.image_path %>" onerror="this.src='https://images.unsplash.com/photo-1581092921461-e777640d82fc?auto=format&fit=crop&q=80&w=400'" class="w-full h-full object-cover">
          <% } else { %>
            <img src="https://images.unsplash.com/photo-1512428559087-565658d65721?auto=format&fit=crop&q=80&w=400" class="w-full h-full object-cover">
          <% } %>
          <span class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded-full text-xs font-bold text-slate-800">
            <%= new Date(n.created_at).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) %>
          </span>
        </div>

        <!-- CONTENU -->
        <div class="p-6 flex flex-col flex-1">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-1 bg-red-100 text-red-700 rounded"><%= n.category %></span>
          </div>
          <h3 class="text-xl font-bold mb-2 leading-tight"><%= n.title %></h3>
          <p class="text-slate-600 text-sm mb-4 line-clamp-3"><%= n.content %></p>
          
          <!-- AUTEUR ET BOUTON -->
          <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-xs">
                <%= n.author ? n.author.charAt(0).toUpperCase() : 'A' %>
              </div>
              <div>
                <p class="text-[10px] text-slate-400 font-bold uppercase">Auteur</p>
                <p class="text-xs font-bold text-slate-700 truncate max-w-[100px]"><%= n.author || 'Admin' %></p>
              </div>
            </div>
            <a href="/news/<%= n.id %>" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors">Lire la suite</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>