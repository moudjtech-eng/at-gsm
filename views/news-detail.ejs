<%- include('partials/header') %>

<div class="max-w-3xl mx-auto pb-10">
  <a href="/" class="inline-flex items-center gap-2 text-slate-500 hover:text-primary font-semibold mb-6 transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
    Retour à l'accueil
  </a>

  <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-200">
    <!-- Image de couverture -->
    <div class="h-64 md:h-96 bg-slate-100 relative w-full">
      <% if (article.image_path) { %>
        <img src="/uploads/<%= article.image_path %>" onerror="this.src='https://images.unsplash.com/photo-1581092921461-e777640d82fc?auto=format&fit=crop&q=80&w=1200'" class="w-full h-full object-cover">
      <% } else { %>
        <img src="https://images.unsplash.com/photo-1512428559087-565658d65721?auto=format&fit=crop&q=80&w=1200" class="w-full h-full object-cover">
      <% } %>
      <div class="absolute top-6 left-6 bg-white/90 backdrop-blur px-4 py-2 rounded-full text-sm font-bold text-slate-800 shadow-sm">
        <%= article.category %>
      </div>
    </div>

    <div class="p-6 md:p-10">
      <h1 class="text-3xl md:text-5xl font-extrabold text-dark leading-tight mb-4"><%= article.title %></h1>
      
      <!-- Infos Auteur et Date -->
      <div class="flex items-center gap-4 border-b border-slate-100 pb-6 mb-8">
        <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-lg">
          <%= article.author ? article.author.charAt(0).toUpperCase() : 'A' %>
        </div>
        <div>
          <p class="text-sm font-bold text-slate-700">Publié par <span class="text-primary"><%= article.author || 'Administrateur' %></span></p>
          <p class="text-xs text-slate-500">
            Le <%= new Date(article.created_at).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
          </p>
        </div>
      </div>

      <!-- Contenu de l'article -->
      <div class="prose prose-lg text-slate-700 leading-relaxed whitespace-pre-wrap">
        <%= article.content %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>