<%- include('partials/header') %>
<div class="max-w-md mx-auto mt-12">
  <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-xl text-center">
    <h2 class="text-2xl font-bold mb-6">Nouveau mot de passe</h2>
    
    <form action="/auth/reset-password/<%= token %>" method="POST" class="space-y-4 text-left">
      <div>
        <label class="text-sm font-bold text-slate-700">Nouveau mot de passe (min. 6 caractères)</label>
        <input name="password" type="password" required minlength="6" class="w-full px-4 py-3 border border-slate-300 rounded-xl mt-1">
      </div>
      <button type="submit" class="w-full py-3 bg-primary text-white rounded-xl font-bold hover:bg-red-700">Enregistrer</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>