<%- include('../partials/header') %>
<h1 class="text-2xl md:text-3xl font-bold mb-6">Candidatures</h1>
<div class="bg-white rounded-2xl border shadow-sm overflow-x-auto">
  <table class="w-full text-sm min-w-[900px]">
    <thead class="bg-slate-50"><tr>
      <th class="px-4 py-3 text-left">Nom</th>
      <th class="px-4 py-3 text-left">Profil</th>
      <th class="px-4 py-3 text-left">Contact</th>
      <th class="px-4 py-3 text-left">Docs</th>
      <th class="px-4 py-3 text-left">Statut</th>
      <th class="px-4 py-3 text-right">Actions</th>
    </tr></thead>
    <tbody class="divide-y">
      <% if (!applications.length) { %>
        <tr><td colspan="6" class="px-4 py-8 text-center text-slate-400 italic">Aucune candidature reçue</td></tr>
      <% } %>
      
      <% applications.forEach(a => { %>
        <tr>
          <td class="px-4 py-3 font-medium">
            <%= a.name %>
            <p class="text-xs text-slate-500"><%= a.spec %></p>
          </td>
          <td class="px-4 py-3">
            <% if (a.member_type === 'new') { %>
              <span class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded text-[10px] font-bold uppercase mb-1 inline-block">Nouveau</span>
              <p class="text-xs text-slate-600">Frais: <strong class="text-primary"><%= a.adhesion_fee %> FCFA</strong></p>
              <% if (a.transaction_ref) { %>
                <p class="text-[10px] text-green-600 font-bold">✅ Payé via KkiaPay</p>
              <% } else { %>
                <p class="text-[10px] text-red-600 font-bold">❌ Paiement non effectué</p>
              <% } %>
              <p class="text-[10px] text-slate-500">Formateur: <%= a.trainer_phone %> (<%= a.trainer_is_bohicon === 1 ? 'Bohicon' : 'Hors Bohicon' %>)</p>
            <% } else { %>
              <span class="bg-green-100 text-green-700 px-2 py-0.5 rounded text-[10px] font-bold uppercase">Ancien membre</span>
            <% } %>
          </td>
          <td class="px-4 py-3">
            <p class="text-xs"><%= a.email %></p>
            <p class="text-xs"><%= a.phone %></p>
          </td>
          <td class="px-4 py-3">
            <% if (a.docs_path) { %>
              <a href="/uploads/<%= a.docs_path %>" target="_blank" class="inline-flex items-center gap-1 bg-red-50 text-red-700 px-2 py-1 rounded font-bold text-[10px] hover:bg-red-100">
                Voir PDF
              </a>
            <% } else { %> — <% } %>
          </td>
          <td class="px-4 py-3">
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= a.status === 'pending' ? 'bg-yellow-100 text-yellow-700' : a.status === 'accepted' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
              <%= a.status %>
            </span>
          </td>
          <td class="px-4 py-3 text-right space-y-1 md:space-y-0 md:space-x-2 whitespace-nowrap">
            <% if (a.status === 'pending') { %>
              <form action="/admin/applications/<%= a.id %>/accept" method="POST" class="inline" onsubmit="return confirm('Créer un compte pour ce membre ?')">
                <button class="bg-green-600 text-white px-3 py-1 rounded text-xs font-bold hover:bg-green-700">Accepter</button>
              </form>
              <form action="/admin/applications/<%= a.id %>/reject" method="POST" class="inline">
                <button class="bg-red-600 text-white px-3 py-1 rounded text-xs font-bold hover:bg-red-700">Rejeter</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>